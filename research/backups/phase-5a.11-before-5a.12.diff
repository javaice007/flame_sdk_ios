diff --git a/Podfile b/Podfile
index aef8817..3afed85 100644
--- a/Podfile
+++ b/Podfile
@@ -27,6 +27,12 @@ variant = ENV.fetch('FLAME_SDK_VARIANT', 'tk').downcase
 # core-named 构建期复用 core 的依赖（只含 OpenSSL），构建后由脚本改名
 variant = 'core' if variant == 'core-named'
 
+# tk-plugin / tb-plugin 构建期复用对应平台的依赖（OpenSSL + AnyThinkiOS / ToBid-iOS-RC），
+# 由 xcFramework_build.sh 通过 EXCLUDED_SOURCE_FILE_NAMES 剔除 core/ads/utils 源码 + 对端平台，
+# 并注入 FLAME_BUILD_<plat> + FLAME_PLUGIN_<plat> 宏（Phase 5A.11 方案 E 插件二进制）
+variant = 'tk' if variant == 'tk-plugin'
+variant = 'tb' if variant == 'tb-plugin'
+
 unless ['tk', 'tb', 'core'].include?(variant)
   raise "❌ Invalid FLAME_SDK_VARIANT=#{variant}. Use tk, tb or core."
 end
@@ -38,6 +44,18 @@ platform :ios, '13.0'
 source 'https://cdn.cocoapods.org/'
 # source 'https://github.com/CocoaPods/Specs.git'
 
+# Phase 5A.11 Step 2 — 链接模式按变体区分
+# 关键差异：AnyThinkSDK 是 dynamic framework（头+dylib），ToBid-iOS-RC 内的
+# WindMillSDK/WindSDK/WindFoundation 都是 static archive（伪装成 framework 的 .a）。
+#   - tk-plugin / tk：AnyThinkSDK 是动态库，:linkage => :static 不会把它合并进来
+#   - tb-plugin：ToBid 静态归档若按常规方式，CocoaPods 生成的 -framework "Wind*"
+#     会让 ld 把全部 WindMill 对象文件（3600+）合并进 plugin binary（6.8M）。
+#     解决：tb-plugin 仍用 :linkage => :static，但 post_install 钩子会从 xcconfig
+#     剔除 -framework "Wind*" flag 并追加 -undefined dynamic_lookup，让 WindMill
+#     符号留为未定义，运行期由 flame_sdk_ios_tb.podspec dependency 'ToBid-iOS-RC' 解析。
+#     头文件仍可访问（use_frameworks! 暴露 WindMillSDK.framework/Headers）。
+#   - tb（legacy）：:linkage => :static，故意把 WindMill 静态内置进 binary（自包含模式）
+
 target 'flame_sdk_ios' do
   use_frameworks! :linkage => :static
 
@@ -56,9 +74,11 @@ target 'flame_sdk_ios' do
 
   if variant == 'tb'
     # TB / ToBid 构建期依赖
-    # 注意：这里只是 SDK 构建期需要 ToBid 头文件和静态库。
-    # flame_sdk_ios_tb.podspec 分发期不能再声明 ToBid-iOS-RC，
-    # 因为 build/tb/flame_sdk_ios.xcframework 已经静态内置 WindMill。
+    # - legacy tb 变体：:linkage => :static 会把 ToBid 静态归档内置进 binary（自包含模式），
+    #   flame_sdk_ios_tb.podspec 分发期不再声明 ToBid-iOS-RC
+    # - tb-plugin 变体：use_frameworks!（动态）让 ToBid 留在外部动态 framework，
+    #   plugin binary 只含 Flame 自己的 FlameTBProvider/TbRewardAdapter，
+    #   分发期由 flame_sdk_ios_tb.podspec dependency 'ToBid-iOS-RC' 提供
     pod 'ToBid-iOS-RC', '5.5.6'
   end
 
@@ -120,4 +140,7 @@ post_install do |installer|
       config.build_settings['HEADER_SEARCH_PATHS'] << ' ${PODS_ROOT}/OpenSSL-Universal/OpenSSL.xcframework/ios-arm64_x86_64-simulator/OpenSSL.framework/Headers'
     end
   end
+  # 注：Phase 5A.11 Step 2 tb-plugin 的 Wind* 链接隔离不在 post_install 内做，
+  # 因为 CocoaPods 1.16.2 在 post_install 之后会重新写出 xcconfig（覆盖我们的 patch）。
+  # 改由 xcFramework_build.sh 在 pod install 完成后直接改写 xcconfig 文件（见脚本内 patch_xcconfig）。
 end
